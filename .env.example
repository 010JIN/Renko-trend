# 交易所API配置
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSWORD=your_okx_password_here

BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here

# 数据库配置（可选）
DATABASE_URL=postgresql://user:password@localhost:5432/renko_db

# Redis配置（可选）
REDIS_URL=redis://localhost:6379/0

# Telegram通知（可选）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email通知（可选）
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_TO_ADDRESS=recipient@example.com

# 系统配置
ENVIRONMENT=development  # development | production
DEBUG=true
LOG_LEVEL=INFO

# 风险管理
MAX_POSITION_SIZE=1000
MAX_DAILY_LOSS=200
